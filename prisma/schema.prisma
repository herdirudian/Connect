// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  MEMBER
  ADMIN
  STAFF
  VERIFICATOR
}

enum Tier {
  EXPLORER
  NATURE_LOVER
  LODGE_GUARDIAN
}

enum TransactionType {
  EARN
  REDEEM
  ADJUSTMENT
}

enum OrderChannel {
  MEMBER
  ROOM_SERVICE
  DINE_IN
}

enum TicketStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

// Models

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(MEMBER)
  tier          Tier      @default(EXPLORER)
  points        Int       @default(0)
  referralCode  String    @unique
  phoneNumber   String?
  dateOfBirth   DateTime?
  avatarUrl     String?
  permissions   String?   @db.Text // JSON string list of specific permissions
  
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  isVerified                Boolean   @default(false)
  
  // Password Reset
  resetToken                String?
  resetTokenExpiry          DateTime?

  // Referral System
  referredById  String?
  referredBy    User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("UserReferrals")

  // Family Relation
  familyId      String?
  family        Family?   @relation(fields: [familyId], references: [id])
  isFamilyHead  Boolean   @default(false)
  familyRelation String?  // e.g. "Spouse", "Child", "Sibling"
  
  // Relations
  transactions  Transaction[]
  tickets       Ticket[]
  bookings      Booking[]
  notifications Notification[]
  userRewards   UserReward[]
  partnerPromoClaims PartnerPromoClaim[]
  restaurantReservations RestaurantReservation[]
  foodOrders             FoodOrder[]
  reviews                Review[]
  userPassportMissions   UserPassportMission[]
  userBadges             UserBadge[]
  communityGroups        UserCommunityGroup[]
  auditLogs              AuditLog[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([isRead])
}

model TierConfig {
  id          String   @id @default(uuid())
  tier        Tier     @unique
  name        String
  minPoints   Int      @default(0)
  benefits    String   @db.Text // JSON string list
  color       String   @default("bg-blue-500")
  icon        String   @default("Star")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  
  // Target: Accommodation
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id])
  
  // Target: Attraction
  attractionId    String?
  attraction      Attraction?    @relation(fields: [attractionId], references: [id])

  // Target: Restaurant
  restaurantId    String?
  restaurant      Restaurant?    @relation(fields: [restaurantId], references: [id])
  
  // Source Transaction (to ensure one review per visit)
  bookingId       String?        @unique
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  
  foodOrderId     String?        @unique
  foodOrder       FoodOrder?     @relation(fields: [foodOrderId], references: [id])
  
  rating          Int            // 1-5
  comment         String?        @db.Text
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Family {
  id        String   @id @default(uuid())
  name      String
  members   User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  amount      Int
  type        TransactionType
  description String
  source      String?         // e.g., "TICKET_PURCHASE", "F&B", "REFERRAL"
  balanceAfter Int?
  referenceId  String?
  createdBy    String?
  createdAt   DateTime        @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

model Ticket {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  title       String
  description String?
  qrCode      String?      // Base64 or URL
  status      TicketStatus @default(ACTIVE)
  validUntil  DateTime
  usedAt      DateTime?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bookingId   String?
  booking     Booking?     @relation(fields: [bookingId], references: [id])
  @@index([status])
}

model Booking {
  tickets     Ticket[]
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // "GLAMPING", "EVENT", "WAHANA"
  details     String   @db.Text // JSON string for specific details
  date        DateTime
  status      String   // "PENDING", "CONFIRMED", "CANCELLED"
  
  // Payment Info
  amount        Float    @default(0)
  paymentId     String?  @unique // Xendit Invoice ID
  paymentUrl    String?  // Xendit Invoice URL
  paymentStatus String   @default("PENDING") // PENDING, PAID, EXPIRED, FAILED

  review        Review?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model PromoCode {
  id           String   @id @default(uuid())
  code         String   @unique
  description  String?
  discountType String   // "PERCENT" or "FIXED"
  value        Float
  maxDiscount  Float?
  minAmount    Float?
  applicableTo String   @default("ALL") // "ALL", "WAHANA", "GLAMPING"
  active       Boolean  @default(true)
  validFrom    DateTime?
  validUntil   DateTime?
  usageLimit   Int?
  usedCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Attraction {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  category    String   @default("RIDE") // "TICKET", "RIDE", "STAY", "FOOD", "TREKKING", "PACKAGE"
  price       Float
  points      Int      @default(0)
  rating      Float    @default(0)
  imageUrl    String?
  videoUrl    String?  // Short video loops (Reels style)
  images      String?  @db.Text // JSON string for gallery images
  status      String   @default("OPEN") // "OPEN", "MAINTENANCE", "CROWDED"
  waitTime    String?  // Estimasi antrean: "5-10 menit"
  tags        String?  // #RamahAnak, #Ekstrem, #Instagramable
  benefits    String?  @db.Text // JSON string list of benefits
  active      Boolean  @default(true)
  originalPrice Float? // Price before discount (for display only)
  displayTarget String   @default("BOTH") // "BOTH", "BOOKING", "EXPLORE"
  allowVoucherClaim Boolean @default(false)
  maxVoucherPax     Int     @default(10)
  voucherExpiry     DateTime? @default("2026-07-31T23:59:59.000Z")
  
  // Event specific fields
  isEvent           Boolean @default(false)
  eventDate         DateTime?
  eventMaxQuota     Int?
  eventSoldQuota    Int     @default(0)
  eventPromoPrice   Float?
  eventPromoQuota   Int?
  
  sortOrder         Int      @default(0)
  isLandingHub      Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviews     Review[]
  priceSchedules AttractionPriceSchedule[]
}

model Promotion {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  imageUrl    String
  linkUrl     String?
  active      Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExploreSettings {
  id                String   @id @default("singleton")
  comparisonData    String   @db.Text // JSON string for comparison table rows
  priceBasic        String   @default("Rp 50.000")
  priceReguler      String   @default("Rp 125.000")
  priceTerusan      String   @default("Rp 165.000")
  originalPriceBasic String? @default("") // Struck price
  originalPriceReguler String? @default("") // Struck price
  originalPriceTerusan String? @default("") // Struck price
  
  // Live Status
  operationalStatus String   @default("NORMAL") // "NORMAL", "WEATHER_DELAY", "MAINTENANCE"
  weatherInfo       String   @default("Cerah")
  statusMessage     String   @default("Seluruh Wahana Beroperasi Normal")
  
  // Itinerary
  itineraryData     String?  @db.Text // JSON string for time-based suggestions
  
  // Amenities
  amenitiesData     String?  @db.Text // JSON string for nearby facilities (Toilet, Mushola, etc)
  
  // Digital Map
  mapImageUrl       String?  @db.LongText
  
  // Calculator
  calculatorData    String?  @db.Text // JSON string for calculator items (name & price)
  
  updatedAt         DateTime @updatedAt
}

model Restaurant {
  id          String   @id @default(uuid())
  name        String
  type        String   // e.g. "Buffet", "Coffee"
  description String
  rating      Float    @default(0)
  status      String   // "Open", "Closed"
  imageUrl    String?
  menuUrl     String?
  active      Boolean  @default(true)
  
  allowReservations Boolean @default(true)
  allowOrders       Boolean @default(true)
  minOrderAmount    Float   @default(0)
  
  menuItems     MenuItem[]
  reservations  RestaurantReservation[]
  orders        FoodOrder[]
  reviews       Review[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id            String      @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id])
  name          String
  description   String?
  price         Float
  category      String      // e.g. "Main", "Drink"
  imageUrl      String?
  originalPrice Float?      // Price before discount (for display only)
  available     Boolean     @default(true)
  soldOut       Boolean     @default(false)
  stock         Int?
  minOrderQty   Int         @default(1)
  
  orderItems    FoodOrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model RestaurantReservation {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  restaurantId  String
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id])
  date          DateTime
  time          String      // e.g. "19:00"
  pax           Int
  status        String      // "PENDING", "CONFIRMED", "CANCELLED", "COMPLETED"
  notes         String?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model FoodOrder {
  id             String       @id @default(uuid())
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  restaurantId   String
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id])
  status         String       // "PENDING", "PREPARING", "READY", "COMPLETED", "CANCELLED"
  totalAmount    Float

  // Channel & guest info (for Room Service public orders)
  channel        OrderChannel @default(MEMBER)
  guestName      String?
  roomNumber     String?
  tableNumber    String?
  guestPhone     String?
  deliveryNotes  String?
  
  // Payment integration
  paymentId      String?      @unique
  paymentUrl     String?
  paymentStatus  String       @default("PENDING")
  
  items          FoodOrderItem[]
  review         Review?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([paymentStatus])
  @@index([createdAt])
}

model FoodOrderItem {
  id            String      @id @default(uuid())
  orderId       String
  order         FoodOrder   @relation(fields: [orderId], references: [id])
  menuItemId    String
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id])
  quantity      Int
  price         Float       // Snapshot price
  requestNote   String?     // Special request per item
}

model HousekeepingItem {
  id        String  @id @default(uuid())
  name      String
  category  String
  price     Float
  available Boolean @default(true)
  stock     Int?    // optional stock
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems HousekeepingOrderItem[]
}

model HousekeepingOrder {
  id            String     @id @default(uuid())
  status        String     @default("PENDING")     // PENDING, PREPARING, COMPLETED, CANCELLED
  paymentStatus String     @default("PENDING")     // PENDING, PAID, EXPIRED
  paymentId     String?    @unique
  paymentUrl    String?
  totalAmount   Float
  channel       OrderChannel @default(ROOM_SERVICE)
  guestName     String?
  roomNumber    String?
  guestPhone    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         HousekeepingOrderItem[]
}

model HousekeepingOrderItem {
  id        String            @id @default(uuid())
  orderId   String
  order     HousekeepingOrder @relation(fields: [orderId], references: [id])
  itemId    String
  item      HousekeepingItem  @relation(fields: [itemId], references: [id])
  quantity  Int
  price     Float
  requestNote String?
}
model Accommodation {
  id          String   @id @default(uuid())
  name        String
  capacity    String
  price       Float
  points      Int      @default(0)
  stock       Int      @default(0)
  description String
  rating      Float    @default(0)
  imageUrl    String?
  images      Json?    // Array of image URLs for slider
  benefits    String?  @db.Text
  active      Boolean  @default(true)
  originalPrice Float? // Price before discount (for display only)
  receptionEmail String? // Email for booking notifications
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  allotments  AccommodationAllotment[]
  reviews     Review[]
}

model AccommodationAllotment {
  id              String        @id @default(uuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  date            DateTime
  quota           Int           // Available stock for this specific date
  price           Float?        // Optional specific price for this date
  
  @@unique([accommodationId, date])
}

model AttractionPriceSchedule {
  id           String     @id @default(uuid())
  attractionId String
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  validFrom    DateTime
  validUntil   DateTime
  price        Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@index([attractionId, validFrom, validUntil])
}
model Reward {
  id          String   @id @default(uuid())
  name        String
  description String
  cost        Int
  type        String   // "VOUCHER", "MERCH", "TICKET", "BIRTHDAY"
  imageUrl    String?
  active      Boolean  @default(true)
  userRewards UserReward[]
}

// ==========================================
// GAMIFICATION: PASSPORT, MISSIONS, & BADGES
// ==========================================

model Passport {
  id          String   @id @default(uuid())
  name        String   // e.g., "Wellness Passport", "Adventure Passport"
  description String   @db.Text
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  missions    PassportMission[]
}

model PassportMission {
  id           String   @id @default(uuid())
  passportId   String
  passport     Passport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  name         String   // e.g., "Join Yoga 4x"
  description  String?
  targetCount  Int      @default(1) // Number of actions required
  pointsReward Int      @default(0) // Points awarded upon completion
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userProgress UserPassportMission[]
}

model UserPassportMission {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId    String
  mission      PassportMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  currentCount Int      @default(0)
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([userId, missionId])
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  imageUrl    String?
  condition   String?  // e.g., "COMPLETE_WELLNESS_PASSPORT"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())
  
  @@unique([userId, badgeId])
}

// ==========================================
// COMMUNITY: GROUPS, EVENTS, & GALLERY
// ==========================================

model CommunityGroup {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  imageUrl    String?
  color       String   @default("bg-brand-50 text-brand")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     UserCommunityGroup[]
}

model UserCommunityGroup {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([userId, groupId])
}

model CommunityGallery {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String
  active      Boolean  @default(true)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserReward {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  rewardId  String
  reward    Reward    @relation(fields: [rewardId], references: [id])
  status    String    @default("ACTIVE") // ACTIVE, USED
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PartnerPromo {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  validUntil  DateTime?
  active      Boolean  @default(true)
  claimable   Boolean  @default(false)
  isPartner   Boolean  @default(true) // True for Partner Promos, False for Internal/Admin Banners
  showButton  Boolean  @default(true) // Toggle "View Details" button
  claims      PartnerPromoClaim[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PartnerPromoClaim {
  id         String       @id @default(uuid())
  promoId    String
  promo      PartnerPromo @relation(fields: [promoId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  uniqueCode String?      @unique
  status     String       @default("ACTIVE")
  usedAt     DateTime?
  createdAt  DateTime     @default(now())
}

model SystemSetting {
  key         String   @id
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RoomServiceRoom {
  id        String   @id @default(uuid())
  number    String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DineInTable {
  id        String   @id @default(uuid())
  number    String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VoucherClaim {
  id              String   @id @default(uuid())
  fullName        String
  phoneNumber     String
  email           String
  city            String
  visitDate       DateTime
  visitorCount    String   // e.g. "1 org", "2 org", "3-5 org", ">5 org"
  voucherCode     String   @unique
  isUsed          Boolean  @default(false)
  claimedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([phoneNumber])
  @@index([voucherCode])
}

model ChildrensDayRegistration {
  id              String   @id @default(cuid())
  parentName      String
  parentPhone     String?
  parentEmail     String
  parentCity      String
  childName       String
  childAge        Int
  visitDate       String
  agreedToPrivacy Boolean  @default(true)
  sponsor         String   @default("NONE") // "NONE" or "BIODEF"
  isUsed          Boolean  @default(false)
  usedAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([parentEmail])
  @@index([parentPhone])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  // Who performed the action (Admin/Staff)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // e.g., "UPDATE_BOOKING", "REDEEM_REWARD", "ADJUST_POINTS"
  entityType  String   // e.g., "Booking", "User", "Reward"
  entityId    String   // The ID of the entity affected
  details     String?  @db.Text // JSON string containing changes or additional context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
